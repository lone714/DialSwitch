<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- WPF 做設定視窗（Fluent 主題），WinForms 只用在系統匣圖示與提示卡片 -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001：Fluent 主題（ThemeMode）標示為實驗性 API；WFO0003：DPI 由 app.manifest 設定，WPF 需要 -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>

    <AssemblyName>DialSwitch</AssemblyName>
    <Product>旋鈕切換</Product>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) 2026 david</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF 與 WinForms 有很多同名類別，不用全域 using，各檔案自己指定 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
